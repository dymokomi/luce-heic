#==============================================================================================
#
#   heic/cabac - The CABAC arithmetic decoder and its context variables
#
#   The engine keeps the 9-bit offset scaled by 2^7 with up to seven prefetched bits below
#   it, reading whole bytes. After a terminating bin equal to 1 (end of a substream or a
#   pcm_flag) the bits already fetched are exactly the stop bit and its alignment, so the
#   next substream starts at `position`. Only I slices exist here, so each context has the
#   one initialisation value of initType 0.
#
#==============================================================================================

# Context offsets, one run of contexts per syntax element.
let ctx_sao_merge: usize = 0
let ctx_sao_type: usize = 1
let ctx_split_cu: usize = 2
let ctx_bypass: usize = 5
let ctx_part_mode: usize = 6
let ctx_prev_intra: usize = 7
let ctx_chroma_mode: usize = 8
let ctx_split_tu: usize = 9
let ctx_cbf_luma: usize = 12
let ctx_cbf_chroma: usize = 14
let ctx_transform_skip: usize = 19
let ctx_qp_delta: usize = 21
let ctx_last_x: usize = 23
let ctx_last_y: usize = 41
let ctx_csbf: usize = 59
let ctx_sig: usize = 63
let ctx_gt1: usize = 107
let ctx_gt2: usize = 131
let contexts: usize = 137

## Tables 9-5 to 9-37: initValue of every context for initType 0, in the order above.
let init_values: u8[137] = [
    153, 200, 139, 141, 157, 154, 184, 184, 63, 153, 138, 138, 111, 141, 94, 138, 182, 154, 154, 139, 139, 154, 154,
    110, 110, 124, 125, 140, 153, 125, 127, 140, 109, 111, 143, 127, 111, 79, 108, 123, 63,
