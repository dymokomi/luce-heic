## Dequantises the parsed levels in `c.coeffs` for component `component`, transforms
## them and adds the residual to the prediction already in the plane at (x0, y0).
## Coefficients beyond (`max_x`, `max_y`) are zero.
func reconstruct(c: Ctx*, component: u32, x0: usize, y0: usize, log2: u32, skip: bool, max_x: usize, max_y: usize) -> !:
    let pic = c.pic
    let n = (usize)1 << log2
    let depth = pic.bits if component == 0 else pic.bits_c
    if not c.bypass:
        let qp = (c.qp_y + 6 * (i32)(pic.bits - 8) if component == 0 else c.qp_cb if component == 1 else c.qp_cr)
        if qp < 0:
            error(corrupt, "HEVC quantisation parameter is negative")
        let scale = level_scale[(usize)(qp % 6)] << (u32)(qp // 6)
        let shift = (u32)depth + log2 - 5
        let add = (i64)1 << (shift - 1)
        let flat = not c.sps.scaling_enabled or (skip and n > 4)
        for y in 0..=max_y:
            for x in 0..=max_x:
                let v = (i64)c.coeffs[y * n + x]
                if v != 0:
                    let m: i64 = 16 if flat else (i64)c.scaling.factor(log2, component, x, y)
                    let d = (v * m * scale + add) >> shift
                    c.coeffs[y * n + x] = (i32)(-32768 if d < -32768 else 32767 if d > 32767 else d)
        let final_shift = 20 - depth
        let round = (i32)1 << (final_shift - 1)
        let dst = component == 0 and log2 == 2
        if skip:
            for i in 0..<n * n:
                c.coeffs[i] = ((c.coeffs[i] << 7) + round) >> final_shift
        elif max_x == 0 and max_y == 0 and not dst:
            # Only the DC coefficient: both DCT stages give a constant (64 · d, twice).
            let g = (64 * c.coeffs[0] + 64) >> 7
            let dc = (64 * (-32768 if g < -32768 else 32767 if g > 32767 else g) + round) >> final_shift
            for i in 0..<n * n:
                c.coeffs[i] = dc
        else:
            inverse_transform(c, log2, dst, max_x, max_y, final_shift)
    let plane = pic.plane(component)
    let stride = pic.width if component == 0 else pic.cwidth
    let high = ((i32)1 << depth) - 1
    for y in 0..<n:
        let row = (y0 + y) * stride + x0
        for x in 0..<n:
            let v = (i32)plane[row + x] + c.coeffs[y * n + x]
            plane[row + x] = (u16)(0 if v < 0 else high if v > high else v)

## The two-stage inverse transform of `c.coeffs` in place (8.6.4.2), with the
## intermediate clipping and the final `shift` of 8.6.2.
func inverse_transform(c: Ctx*, log2: u32, dst: bool, max_x: usize, max_y: usize, shift: u32):
    let n = (usize)1 << log2
    var line: i32[32] = ---
    var out: i32[32] = ---
    for i in 0..<n * n:
        c.temp[i] = 0
    # Columns: e[x][y] = sum over k of M[k][y] d[x][k].
    for x in 0..=max_x:
        for k in 0..<n:
            line[k] = c.coeffs[k * n + x]
        inverse_line(line, n, max_y + 1, dst, out)
        for y in 0..<n:
            let g = (out[y] + 64) >> 7
            c.temp[y * n + x] = -32768 if g < -32768 else 32767 if g > 32767 else g
    # Rows: r[x][y] = sum over k of M[k][x] g[k][y].
    let round = (i32)1 << (shift - 1)
    for y in 0..<n:
        for k in 0..<n:
            line[k] = c.temp[y * n + k]
        inverse_line(line, n, max_x + 1, dst, out)
        for x in 0..<n:
            c.coeffs[y * n + x] = (out[x] + round) >> shift

## One 1-D inverse transform of `n` points: coefficients `input` (zero from `count` on)
## to samples `output`. The DST is a plain matrix product; the DCT splits into its even
## part, an n/2-point DCT of the even coefficients, and its odd part, as the reference
## decoder's partial butterflies do.
func inverse_line(input: const i32[], n: usize, count: usize, dst: bool, output: i32[]):
    if dst:
        for i in 0..<(usize)4:
            var sum: i32 = 0
            for k in 0..<count:
                sum += dst4[k * 4 + i] * input[k]
            output[i] = sum
        return
    if n == 4:
        let e0 = 64 * (input[0] + input[2])
        let e1 = 64 * (input[0] - input[2])
        let o0 = 83 * input[1] + 36 * input[3]
        let o1 = 36 * input[1] - 83 * input[3]
        output[0] = e0 + o0
        output[1] = e1 + o1
        output[2] = e1 - o1
        output[3] = e0 - o0
        return
    let half = n >> 1
    let row = ((usize)32 // n) * 32
    var evens: i32[16] = ---
    var even: i32[16] = ---
    for k in 0..<half:
        evens[k] = input[2 * k]
    inverse_line(evens, half, (count + 1) >> 1, false, even)
    for k in 0..<half:
        var odd: i32 = 0
        var j: usize = 1
        while j < count:
            odd += (i32)dct32[j * row + k] * input[j]
            j += 2
        output[k] = even[k] + odd
        output[n - 1 - k] = even[k] - odd
