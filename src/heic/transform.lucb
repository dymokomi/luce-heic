#==============================================================================================
#
#   heic/transform - Scaling (dequantisation), the inverse transforms and reconstruction
#   (8.6.2 to 8.6.4): the 4x4 DST for intra luma, the 4- to 32-point DCT, transform skip
#   and lossless (transquant bypass) blocks. Columns and rows beyond the last non-zero
#   coefficient are skipped, which leaves the result unchanged.
#
#==============================================================================================

## levelScale by qP % 6.
let level_scale: i64[6] = [40, 45, 51, 57, 64, 72]

## The 4x4 DST basis (8-315), row k being frequency k.
let dst4: i32[16] = [29, 55, 74, 84, 74, 74, 0, -74, 84, -29, -74, 55, 55, -84, 74, -29]

## The 32-point DCT basis, row k being frequency k; the N-point basis is every (32 / N)th
